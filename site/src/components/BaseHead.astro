---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: string | ImageMetadata;
	noindex?: boolean;
	pubDate?: Date;
	updatedDate?: Date;
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = '/images/head.jpg',
	noindex = false,
	pubDate,
	updatedDate,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const imageURL = new URL(typeof image === 'string' ? image : image.src, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#f8f6f1" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={AUTHOR_NAME} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" sizes="32x32" href="/images/32x32icon.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/images/16x16icon.png" />
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('/rss.xml', Astro.site)} />
<Font cssVariable="--font-atkinson" preload />

<meta property="og:locale" content="zh_CN" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:type" content={pubDate ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={`${AUTHOR_NAME}的博客头像`} />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
