---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PageLayout from './PageLayout.astro';
import { AUTHOR_NAME, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header class="home-intro">
		<p class="eyebrow">个人博客 · 始于 2021</p>
		<h1>{SITE_TITLE}</h1>
		<p class="intro-line">{SITE_DESCRIPTION}。</p>
	</header>
	<div class="home-columns">
		<section aria-labelledby="recent-posts">
			<div class="section-heading">
				<h2 id="recent-posts">最近文章</h2>
				<span>{posts.length} 篇记录</span>
			</div>
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<article>
							<div class="post-meta">
								<FormattedDate date={post.data.pubDate} />
								{post.data.tags.map((tag) => <a class="tag-link" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
							</div>
							<h3><a href={post.data.permalink}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
						</article>
					</li>
				))}
			</ul>
			<a class="archive-link" href="/archives/">查看全部归档 <span aria-hidden="true">→</span></a>
		</section>
		<aside class="author-note" aria-label="关于作者">
			<img src="/images/head.jpg" alt={`${AUTHOR_NAME}的头像`} width="80" height="80" />
			<h2>{AUTHOR_NAME}</h2>
			<p>在这里记录算法、代码与学习中的思考。</p>
			<a class="about-link" href="/about/">关于我 <span aria-hidden="true">→</span></a>
			<div class="author-links">
				<a href={GITHUB_URL} rel="me">GitHub ↗</a>
				<a href="/rss.xml">RSS 订阅</a>
			</div>
		</aside>
	</div>
</PageLayout>

<style>
	.home-intro { margin-bottom: 48px; }
	.home-intro .eyebrow { margin-bottom: 10px; }
	h1 { margin-bottom: 10px; font-size: 34px; }
	.intro-line { margin: 0; color: var(--muted); font-size: 16px; }
	.home-columns { display: grid; grid-template-columns: minmax(0, 1fr) 210px; gap: 68px; }
	.section-heading { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 15px; margin-bottom: 26px; border-bottom: 1px solid var(--line); }
	.section-heading h2 { margin: 0; font-size: 15px; }
	.section-heading span { color: var(--muted); font-size: 12px; }
	.post-list > li { padding-block: 25px; }
	.post-list > li:first-child { padding-top: 0; }
	.post-list h3 { margin-top: 10px; line-height: 1.6; }
	.archive-link { display: inline-block; margin-top: 26px; font-size: 14px; text-decoration: none; }
	.author-note { padding-top: 4px; }
	.author-note img { display: block; margin-bottom: 18px; border-radius: 50%; object-fit: cover; }
	.author-note h2 { margin-bottom: 10px; font-size: 16px; }
	.author-note p { margin-bottom: 14px; color: var(--muted); font-size: 14px; line-height: 1.9; }
	.about-link { font-size: 13px; text-decoration: none; }
	.author-links { display: flex; gap: 20px; margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--line); }
	.author-links a { color: var(--muted); font-size: 12px; text-decoration: none; }
	.author-links a:hover { color: var(--accent); }
	@media (max-width: 800px) {
		.home-columns { grid-template-columns: minmax(0, 1fr); gap: 40px; }
		.author-note { border-top: 1px solid var(--line); padding-top: 28px; }
		.author-note img { float: left; width: 64px; height: 64px; margin: 0 20px 18px 0; }
		.author-note p { margin-bottom: 8px; }
		.author-links { clear: both; justify-content: flex-start; border-top: 0; margin-top: 12px; padding-top: 0; }
	}
	@media (max-width: 620px) {
		.home-intro { margin-bottom: 36px; }
		h1 { font-size: 30px; }
		.intro-line { font-size: 14px; }
	}
</style>
